const { preset, presets } = Astro.props;
const title = `${preset.h1} — free online countdown`;
---

<BaseLayout title={title} description={preset.description}>
  <section class="tool-hero">
    <div class="container tool-hero-inner">
      <p class="eyebrow">Free online timer</p>
      <h1>{preset.h1}</h1>
      <p class="lead mx-auto">Already set. Press start, or type a different time and press Return.</p>

      <div class="tool-timer">
        <Timer initialMinutes={preset.minutes} size="full" showFullscreen={true} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container tool-info">
      <h2>What a {preset.h1.replace(' timer', '')} timer is good for</h2>
      <ul>
        {
          preset.uses.map((u) => (
            <li>
              <strong>{u.lead}:</strong> {u.text}{' '}
              {u.href && <a href={u.href}>{u.linkText}</a>}
              {u.after && ` ${u.after}`}
            </li>
          ))
        }
      </ul>

      <p class="other-note">
        Need a different time? Type it in the timer — "12 min", "90s", or "5pm" — and press
        Return.
      </p>

      <nav class="other-presets" aria-label="Other preset timers">
        <span>Popular timers:</span>
        {
          presets
            .filter((p) => p.slug !== preset.slug)
            .map((p) => <a href={`/timer/${p.slug}`}>{p.h1}</a>)
        }
        <a href="/timer">any time</a>
      </nav>

      <DownloadCTA
        location={`timer_preset_${preset.slug}`}
        body="This is the web version. Get the free Mac app to keep the countdown visible over full screen apps and presentations."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .tool-hero {
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
    text-align: center;
    background:
      radial-gradient(55% 45% at 50% 0%, rgba(10, 132, 255, 0.18), transparent 70%),
      var(--bg);
  }
  .tool-hero-inner {
    max-width: 680px;
  }
  .tool-hero .lead {
    margin-top: 0.625rem;
    max-width: 46ch;
  }
  .tool-timer {
    margin-top: 1.75rem;
  }
  .tool-info {
    max-width: var(--content-width);
  }
  .tool-info ul {
    margin: 1.25rem 0 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    color: var(--text-muted);
  }
  .tool-info strong {
    color: var(--text);
  }
  .other-note {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .other-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    font-size: 0.9375rem;
    color: var(--text-faint);
    margin-bottom: 2.5rem;
  }
  .other-presets a {
    color: var(--text-muted);
  }
  .other-presets a:hover {
    color: var(--text);
  }
</style>
